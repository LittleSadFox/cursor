# Pinned sources for the macOS arm64 LGPL ffmpeg (P0.8 / ADR-002).
# Bump these together. CI cache key hashes versions.env, configure-lgpl.sh,
# build-macos-arm64.sh, and common.sh.

FFMPEG_VERSION=8.1.3
FFMPEG_TARBALL_NAME=ffmpeg-8.1.3.tar.xz
FFMPEG_TARBALL_URL=https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz
FFMPEG_TARBALL_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

ZIMG_VERSION=3.0.5
ZIMG_TARBALL_NAME=zimg-release-3.0.5.tar.gz
ZIMG_TARBALL_URL=https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.5.tar.gz
ZIMG_TARBALL_SHA256=a9a0226bf85e0d83c41a8ebe4e3e690e1348682f6a2a7838f1b8cbff1b799bcf

MACOSX_DEPLOYMENT_TARGET=13.0
FFMPEG_TRIPLE=darwin-arm64
FFMPEG_LICENSE=LGPL-2.1-or-later
