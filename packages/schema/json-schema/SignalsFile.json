{
  "$ref": "#/definitions/SignalsFile",
  "definitions": {
    "SignalsFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "videoId": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tUs": {
                "type": "integer",
                "minimum": 0
              },
              "energy": {
                "type": "number",
                "minimum": 0
              },
              "globalMotion": {
                "type": "number",
                "minimum": 0
              },
              "dx": {
                "type": "number"
              },
              "dy": {
                "type": "number"
              }
            },
            "required": [
              "tUs",
              "energy",
              "globalMotion"
            ],
            "additionalProperties": false
          }
        },
        "activeWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startUs": {
                "type": "integer",
                "minimum": 0
              },
              "endUs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "startUs",
              "endUs"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "camera_moving",
              "hdr_source",
              "vfr_source",
              "routes_detection_off",
              "truncated_file"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "videoId",
        "sampleFps",
        "samples",
        "activeWindows",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
