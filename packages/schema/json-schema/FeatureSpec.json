{
  "$ref": "#/definitions/FeatureSpec",
  "definitions": {
    "FeatureSpec": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "enum": [
                  "f32",
                  "f64",
                  "i32",
                  "bool"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "dtype"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "features"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
