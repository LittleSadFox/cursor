    "migrations:embed": "node scripts/embed-migrations.mjs"
  },
  "dependencies": {
    "@climbing-coach/api": "workspace:*",
    "@climbing-coach/engine": "workspace:*",
    "@climbing-coach/schema": "workspace:*",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@climbing-coach/config": "workspace:*",
    "@climbing-coach/test-fixtures": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1"
  }
